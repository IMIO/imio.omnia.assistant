#: ../browser/controlpanel.py:149
msgid "AI Assistant settings"
msgstr "Paramètres de l'assistant IA"

#: ../browser/controlpanel.py:88
msgid "CSS selector to extract page content from."
msgstr "Sélecteur CSS pour extraire le contenu de la page."

#: ../browser/controlpanel.py:139
msgid "Disclaimer"
msgstr "Avertissement"

#: ../browser/controlpanel.py:140
msgid "Disclaimer text shown at the bottom of the chat panel. Leave empty for the default French disclaimer."
msgstr "Texte d'avertissement affiché en bas du panneau de chat. Laisser vide pour l'avertissement français par défaut."

#: ../browser/controlpanel.py:60
msgid "Enable or disable the AI assistant globally."
msgstr "Activer ou désactiver l'assistant IA globalement."

#: ../browser/controlpanel.py:59
msgid "Enabled"
msgstr "Activé"

#: ../browser/controlpanel.py:82
msgid "Include current page content as context for the AI."
msgstr "Inclure le contenu de la page actuelle comme contexte pour l'IA."

#: ../browser/controlpanel.py:81
msgid "Include page content"
msgstr "Inclure le contenu de la page"

#: ../browser/controlpanel.py:134
msgid "Initial panel height in pixels."
msgstr "Hauteur initiale du panneau en pixels."

#: ../browser/controlpanel.py:128
msgid "Initial panel width in pixels."
msgstr "Largeur initiale du panneau en pixels."

#: ../configure.zcml:25
msgid "Installs the imio.omnia.assistant add-on. Provides an AI chat assistant widget for Plone."
msgstr ""

#: ../browser/controlpanel.py:117
msgid "Layout"
msgstr "Disposition"

#: ../browser/controlpanel.py:101
msgid "Max context characters"
msgstr "Nombre maximum de caractères de contexte"

#: ../browser/controlpanel.py:107
msgid "Max messages per conversation"
msgstr "Nombre maximum de messages par conversation"

#: ../browser/controlpanel.py:102
msgid "Maximum characters of page content to include as context."
msgstr "Nombre maximum de caractères du contenu de la page à inclure comme contexte."

#: ../browser/controlpanel.py:108
msgid "Maximum number of user messages allowed in a single conversation. Set to 0 for no limit."
msgstr "Nombre maximum de messages utilisateur autorisés dans une conversation. Mettre à 0 pour ne pas limiter."

#: ../browser/controlpanel.py:65
msgid "Model"
msgstr "Modèle"

#: ../browser/controlpanel.py:66
msgid "Model for the OpenAI-compatible API."
msgstr "Modèle pour l'API compatible OpenAI."

#: ../configure.zcml:25
msgid "Omnia AI Assistant"
msgstr ""

#: ../browser/controlpanel.py:87
msgid "Page content CSS selector"
msgstr "Sélecteur CSS du contenu de la page"

#: ../browser/controlpanel.py:133
msgid "Panel height"
msgstr "Hauteur du panneau"

#: ../browser/controlpanel.py:127
msgid "Panel width"
msgstr "Largeur du panneau"

#: ../browser/controlpanel.py:71
msgid "System prompt"
msgstr "Prompt système"

#: ../browser/controlpanel.py:72
msgid "System prompt sent with every conversation. The assistant reads the page through the read_page tool: tell the model to call read_page before answering a question about the page. The model must support tool calling."
msgstr "Prompt système envoyé avec chaque conversation. L'assistant lit la page via l'outil read_page : demandez au modèle d'appeler read_page avant de répondre à une question sur la page. Le modèle doit prendre en charge l'appel d'outils."

#: ../configure.zcml:34
msgid "Uninstalls the imio.omnia.assistant add-on."
msgstr ""

#: ../browser/controlpanel.py:94
msgid "Use innerText instead of innerHTML for page content extraction."
msgstr "Utiliser innerText au lieu de innerHTML pour l'extraction du contenu de la page."

#: ../browser/controlpanel.py:93
msgid "Use plain text"
msgstr "Utiliser le texte brut"

#: ../browser/controlpanel.py:118
msgid "floating: a panel opening from a round button in the bottom-right corner. sidebar: a panel docked on the right that pushes the page."
msgstr "floating : panneau qui s'ouvre depuis un bouton rond en bas à droite. sidebar : panneau ancré à droite qui décale la page."

